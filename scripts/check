#!/bin/bash

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"

uv sync --all-extras --locked --no-install-project
uv run --no-sync maturin develop
npm clean-install --ignore-scripts
precious lint --all
cargo fmt --manifest-path fuzz/Cargo.toml --all -- --check
cargo test --locked
CARGO_TARGET_DIR="$repo_root/target" \
    cargo clippy --manifest-path fuzz/Cargo.toml --all-targets --locked -- -D warnings
uv run --no-sync pytest
cargo doc --no-deps --all-features --locked
cargo metadata --locked --format-version 1 --no-deps >/dev/null
cargo metadata --manifest-path fuzz/Cargo.toml --locked --format-version 1 --no-deps \
    >/dev/null
uv lock --check
if [ "$(git -C tests/data rev-parse HEAD)" != "$(git rev-parse :tests/data)" ]; then
    echo "tests/data does not match the staged gitlink; run git submodule update" >&2
    exit 1
fi
